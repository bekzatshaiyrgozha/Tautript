# Copy to .env and adjust:  cp .env.example .env
# Real .env is git-ignored — never commit secrets.

# Server
HOST=127.0.0.1          # use 0.0.0.0 to reach the API from an iPhone on the same Wi-Fi
PORT=8000
RELOAD=true             # auto-reload on code changes (dev only)

# Database (SQLite for MVP)
DB_URL=sqlite:///./tautrip.db

# Auth: key that signs login tokens (`make run` puts a random one into .env).
# Generate manually: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_DAYS=30
VERIFICATION_CODE_TTL_MINUTES=10

# Email for verification codes. Leave SMTP_HOST empty in development:
# codes are then printed in the server log (and shown in the app as a hint).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=TauTrip <no-reply@tautrip.kz>

# Browser origins allowed to call the API (Expo web preview), comma-separated
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081

# External APIs
API_KEY_WEATHER=your-weather-api-key
